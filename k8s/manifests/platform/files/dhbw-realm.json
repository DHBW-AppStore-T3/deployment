{
  "realm": "dhbw",
  "displayName": "DHBW AppStore",
  "enabled": true,
  "loginTheme": "dhbw",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 86400,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "default-roles-dhbw",
        "description": "Every user. No manage-account: users cannot change their e-mail address, which the AppStore matches LTI launches by.",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization"],
          "client": { "account": ["view-profile"] }
        }
      },
      { "name": "offline_access", "description": "${role_offline-access}" },
      { "name": "uma_authorization", "description": "${role_uma_authorization}" },
      { "name": "student", "description": "Uses deployments" },
      { "name": "teacher", "description": "Registers apps and deploys them" },
      { "name": "admin", "description": "Reviews app versions; administers the AppStore" }
    ]
  },
  "defaultRole": { "name": "default-roles-dhbw" },
  "clients": [
    {
      "clientId": "appstore-frontend",
      "name": "AppStore frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "https://__APP_HOST__",
      "baseUrl": "/",
      "redirectUris": [
        "https://__APP_HOST__/callback",
        "https://__APP_HOST__/silent-refresh.html"
      ],
      "webOrigins": ["https://__APP_HOST__"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://__APP_HOST__/login",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": ["basic", "acr", "web-origins", "profile", "roles", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience appstore-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "appstore-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "appstore-self-service",
      "name": "AppStore self-service-ui (second UI)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "https://__SSU_HOST__",
      "baseUrl": "/",
      "redirectUris": ["https://__SSU_HOST__/oauth2/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://__SSU_HOST__/",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": ["basic", "acr", "web-origins", "profile", "roles", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience appstore-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "appstore-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "appstore-backend",
      "name": "AppStore backend (user search)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${APPSTORE_BACKEND_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": ["basic", "acr", "roles"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-appstore-backend",
      "enabled": true,
      "serviceAccountClientId": "appstore-backend",
      "realmRoles": ["default-roles-dhbw"],
      "clientRoles": { "realm-management": ["view-users"] }
    }
  ]
}
