# Reverse proxy and TLS termination for the staging and production stacks.
#
# Replaces nginx. Caddy obtains a real, browser-trusted certificate from DHBW's
# ACME endpoint (HARICA) instead of the self-signed one the Ansible playbook
# generated, which removes the cert step from the playbook, the nginx/certs
# volume, and the NGINX_CONFIG_HASH label trick.
#
# The three settings below come from .env, like everything else the stack is
# configured with. APP_HOSTNAME must be a DNS name that resolves to this VM -
# ACME issues certificates for domains, never for bare IP addresses.
#
# Running this locally: point APP_HOSTNAME at localhost, or add `tls internal`
# inside the site block. Caddy then signs with its own CA and skips ACME
# entirely, so no public DNS record is needed.
{
	acme_ca {$ACME_CA_URL}
	email {$ACME_EMAIL}
}

{$APP_HOSTNAME} {
	# dns-01 rather than an inbound challenge: this host is reachable only over
	# IPv6, and the CA cannot reach it - its endpoint has no AAAA record, and
	# both http-01 and tls-alpn-01 failed here. Caddy writes the TXT record
	# itself over RFC 2136, so nothing has to reach us.
	#
	# Needs the rfc2136 module, which is why this image is built rather than
	# pulled - see Dockerfile.
	tls {
		dns rfc2136 {
			key_name {$DNS_TSIG_KEY_NAME}
			key_alg {$DNS_TSIG_KEY_ALG}
			key {$DNS_TSIG_KEY}
			server {$DNS_SERVER}
		}
	}

	# handle_path strips the prefix before proxying, which is what nginx's
	# `rewrite ^/api/(.*) /$1 break` did.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Keycloak 17+ serves at the root rather than under /auth, so the top-level
	# paths it owns have to be routed before the SPA catch-all below swallows
	# them. reverse_proxy sets X-Forwarded-Proto itself, which is what
	# KC_PROXY=edge relies on to build HTTPS redirect URIs.
	@keycloak path /realms/* /resources/* /admin/* /js/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	handle {
		reverse_proxy frontend:8080
	}

	# nginx capped uploads at 50m via client_max_body_size; Caddy has no limit
	# by default, so it is restated here to keep the behaviour unchanged.
	request_body {
		max_size 50MB
	}
}

# Moodle LTI prototype — optional second site block, used by both
# docker-compose.staging.moodle.yml and docker-compose.moodle.yml. A separate
# domain, not a second port on {$APP_HOSTNAME}: Caddy issues one certificate
# per site block's domain, so a distinct host is the natural way to add a
# second TLS-terminated service.
#
# MOODLE_HOSTNAME defaults to a name inside .invalid (reserved by RFC 2606,
# guaranteed to never resolve) rather than being left unset — an empty or
# missing site-block address is a Caddyfile syntax error, so the moodle-up
# overlay is optional at the Ansible/compose level but this block always
# exists; without MOODLE_HOSTNAME set, Caddy just never gets a matching
# request and never attempts an ACME order for it.
#
# Reuses the zone's TSIG key (DNS_TSIG_KEY*) rather than requesting a second
# one — both hostnames live in the same DNS zone, and RFC 2136 TSIG keys
# authenticate against the zone, not a specific record name.
#
# TEMPORARY (2026-09-24, deployment#43 follow-up): `tls internal` instead of
# the ACME dns-rfc2136 block above. certificates.dhbw.cloud (HARICA) fails
# order finalization for this specific hostname every time — DNS-01
# authorization validates successfully, the order sits in "processing", then
# flips to "invalid" with no error detail from the server. Reproduced
# identically with two independent ACME clients (Caddy itself and a
# standalone certbot/dns-rfc2136 run against the same TSIG key), so this is
# a CA-side issue, not a config problem here — see claude_docs/HANDOVER.md
# for the full investigation. The sibling {$APP_HOSTNAME} block above is
# UNCHANGED and still uses real ACME; only this one host is affected.
# Revert to the dns-rfc2136 block (commented out below) once HARICA's issue
# is resolved — browsers will show a self-signed cert warning until then.
{$MOODLE_HOSTNAME:moodle-disabled.invalid} {
	tls internal

	# tls {
	# 	dns rfc2136 {
	# 		key_name {$DNS_TSIG_KEY_NAME}
	# 		key_alg {$DNS_TSIG_KEY_ALG}
	# 		key {$DNS_TSIG_KEY}
	# 		server {$DNS_SERVER}
	# 	}
	# }

	reverse_proxy moodle:80

	request_body {
		max_size 100MB
	}
}
