.env
.secrets
.DS_Store
__pycache__/

# Provider binaries and module cache — 25 MB per environment, regenerated by
# `terraform init`. .terraform.lock.hcl is NOT ignored: it pins provider
# versions and belongs in git.
.terraform/

# State files. envs/forgejo uses a local backend (see its backend.tf), so an
# apply from an operator's machine drops terraform.tfstate next to the config.
# It records resource IDs and must not be committed — back it up alongside the
# Forgejo database dumps instead.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# `terraform plan -out=tfplan` in the deploy workflow.
tfplan
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
