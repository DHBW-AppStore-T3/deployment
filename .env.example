# ================================================================
# Lokales Dev-Setup: wird per `make env` zu .env kopiert.
#
# Nur diese Werte liest docker-compose.dev.yml aus .env. Alles
# andere hat dort Standardwerte (Ports und Datenbank überschreibbar
# über FRONTEND_PORT, BACKEND_PORT, KEYCLOAK_PORT, DB_PORT, DB_USER,
# DB_PASSWORD, DB_NAME; siehe docs/dev-setup.md).
#
# Staging und Produktion laufen auf Kubernetes (k8s/) und nutzen
# diese Datei nicht.
# ================================================================

# Pflicht: Fernet-Schlüssel, in Backend und Worker gleich.
# `make env` trägt beim Anlegen der .env einen frisch erzeugten Wert ein;
# ein neuer Wert: `make secret`.
CREDENTIAL_ENCRYPTION_KEY=

# Optional: Secret des Keycloak-Clients appstore-backend
# (Standard im Compose: dev-local-secret).
KEYCLOAK_CLIENT_SECRET=
